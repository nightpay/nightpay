# NightPay .gitignore — canonical list of what stays out of the public repo.
# Rationale for each category: docs/architecture.md § "Public vs private (what goes in .gitignore)".
#
# Do not replicate: bridge/ (lives in a separate private repo), credentials,
# internal plans (plans/, LAUNCH.md, docs/MARKETING.md), IDE/local config,
# agent playground secrets, test suites with internal endpoints, VPS runbooks.

node_modules/
.env
.env.*
*.log
/tmp/
nightpay-board.json
*.db
*.db-wal
*.db-shm
__pycache__/
*.pyc
.DS_Store
Thumbs.db
nul
NUL

# Credential / secret filenames (safety net — never commit)
credentials.json
credentials*.json
secrets.json
*-secrets.json

# ── PRIVATE — never commit; do not replicate to public clones ─────────────────
# Bridge: private repo — tracked as git submodule (pointer in root). Source lives in bridge/.
# Do not copy bridge files into the root tree; commit in bridge/ with `git -C bridge`.

# Internal planning, launch kit, marketing drafts; local clones (not for public repo)
plans/
LAUNCH.md
docs/MARKETING.md
.tmp/
/.tmp/activity-sim-*.log
/.tmp/activity-sim-*.pid
/.tmp/activity-sim-state*.json
masumi-services-dev-quickstart

# UI build artifacts (source goes in, dist stays out)
ui/dist/
ui/node_modules/

# VPS / operator runtime artifacts (if running services from this repo)
runtime/
state/
logs/
pids/
*.pid
*.pid.lock
*.sqlite
*.sqlite-wal
*.sqlite-shm

# Stray files
Tempcounter_contents.json

# UI/UX audit screenshots (ad-hoc, not committed)
/[0-9][0-9]-*.png
/[0-9][0-9]b-*.png
/[0-9][0-9]c-*.png
/m[0-9][0-9]-*.png
/m[0-9][0-9]b-*.png
/m[0-9][0-9]c-*.png
/n[0-9][0-9]-*.png
/n[0-9][0-9]b-*.png

# Local fuzz/test scratch
.tmp-fuzz/

# Unrelated side-project notes (never commit)
horse-enrich.md

# Compound Engineering review artifacts (local only)
.ce-reviews/
docs/project-standards.json

# Auto Claude data directory
.auto-claude/

# Claude Code local-only settings (machine-specific permissions, not for sharing)
.claude/settings.local.json
# Cursor/Claude IDE local config and skills (never commit — may contain hosts, keys, paths)
.cursor/
.claude/

# Auto Claude generated files
.auto-claude-security.json
.auto-claude-status
.claude_settings.json
.worktrees/
.security-key
logs/security/
.playwright-mcp/
MEMORY.md

# Agent-only playground runtime and secrets
.agent-playground/
.agent-playground.env
.agent-playground.env.bak*
.agent-playground.env.local
sample-agent/.env
sample-agent/.state/
!.agent-playground.env.example

# Local-only private automation/scripts (never publish)
.private/
/scripts/*
!/scripts/agent-playground-setup.sh
!/scripts/server-sync-start.sh
!/scripts/load-sim.sh
!/scripts/submodule-init.sh
!/scripts/local-dev-start.sh
!/scripts/seed-corpus.sh

# Local SSH private key for Hetzner
/hetzner_ed25519_martin
/hetzner_ed25519_martin.pub

# Generic local SSH / key material (never commit)
/hetzner_*
/id_rsa
/id_rsa.pub
/id_ed25519
/id_ed25519.pub
/*.pem
/*.p12
/*.pk8
docs/HETZNER_X86_RUNBOOK.md
docs/OPERATOR_SESSION.md
docs/OPS_INDEX.md
docs/ADJUSTMENT_DEPLOY_CHECKLIST.md
docs/SERVER_BOOTSTRAP_COPYPASTE.md
docs/NIGHTPAY_DEV_COMPLETION_SYNC_RUNBOOK.md
test/smoke.sh
test/chaos_stress_suite.py

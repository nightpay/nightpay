# NightPay agent playground env template
# Copy this file to .agent-playground.env and fill the values.
# Never commit .agent-playground.env.

export MIDNIGHT_NETWORK="preprod"
export MIP_PORT="8090"
export UI_PORT="3333"

# Required secrets (generate with: openssl rand -hex 32)
export JOB_TOKEN_SECRET="<64-char-hex>"
export OPERATOR_SECRET_KEY="<64-char-hex>"

# Masumi (from masumi-services-dev-quickstart/.env ADMIN_KEY)
# Quick dev: bash scripts/agent-playground-setup.sh init --dummy
#   (random hex placeholders + URLs below — swap MASUMI_API_KEY for real ADMIN_KEY)
export MASUMI_PAYMENT_URL="http://127.0.0.1:3001/api/v1"
export MASUMI_REGISTRY_URL="http://127.0.0.1:3000/api/v1"
# Optional SaaS mode: set this and omit MASUMI_PAYMENT_URL / MASUMI_REGISTRY_URL.
# export MASUMI_SAAS_URL="https://your-masumi-saas-host"
export MASUMI_API_KEY="<ADMIN_KEY>"

# Midnight bridge + contract wiring
export BRIDGE_URL="http://localhost:4000"
export NIGHTPAY_API_URL="http://localhost:${MIP_PORT}"
export BRIDGE_ADMIN_TOKEN="<bridge-deploy-token>"
export OPERATOR_ADDRESS="<64-char-lowercase-hex>"
export RECEIPT_CONTRACT_ADDRESS="<64-char-lowercase-hex>"

# Dev-only toggle for localhost Masumi URLs
export ALLOW_LOCAL_URLS="1"

# Optional tuning
# export OPERATOR_FEE_BPS="200"
# export UNCLAIMED_REFUND_HOURS="24"
# export MIP003_MODE="compat"
# export ONTOLOGY_DIR="./skills/nightpay/ontology"
